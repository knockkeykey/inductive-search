{
  "name": "inductive-search",
  "version": "1.1.0",
  "private": true,
  "description": "感应式搜索：按条件查找网页原文，查看限定范围的搜索结果，并保存本地摘录。基于 Hunch。",
  "author": "tymscar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knockkeykey/inductive-search"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "preview": "esbuild dev/preview.ts --bundle --outfile=dev/preview.js && open dev/preview.html",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src build.mjs",
    "lint:fix": "biome check --write src build.mjs",
    "lint:ext": "web-ext lint --source-dir dist/firefox",
    "check": "npm run typecheck && npm run lint && npm run build && npm run lint:ext",
    "run:firefox": "web-ext run --source-dir dist/firefox",
    "run:chrome": "web-ext run -t chromium --source-dir dist/chrome",
    "package": "npm run build && web-ext build --source-dir dist/firefox --artifacts-dir web-ext-artifacts/firefox --overwrite-dest && web-ext build --source-dir dist/chrome --artifacts-dir web-ext-artifacts/chrome --overwrite-dest"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "web-ext": "^10.7.0",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
